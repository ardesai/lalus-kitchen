# Copy this file to .env and fill in real values before running the app.

# Port the server listens on
PORT=3000

# Interface to bind to. Defaults to 127.0.0.1 (localhost-only), which is
# correct when running behind a reverse proxy like Caddy or nginx. Set to
# 0.0.0.0 only if the server should be reachable directly.
HOST=127.0.0.1

# Session signing secret - set this to a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Admin login credentials
ADMIN_USERNAME=admin
# Generate a bcrypt hash with: node utils/hash-password.js "yourPassword"
ADMIN_PASSWORD_HASH=
