# Copy this file to .env and fill in real values before running the app.

# Port the server listens on
PORT=3000

# Session signing secret - set this to a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Admin login credentials
ADMIN_USERNAME=admin
# Generate a bcrypt hash with: node utils/hash-password.js "yourPassword"
ADMIN_PASSWORD_HASH=
