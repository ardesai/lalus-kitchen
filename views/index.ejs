<%- include('partials/header', { pageTitle: 'Home' }) %>

<section class="hero-banner">
  <div class="container">
    <h1>Recipes worth wiping your hands before you scroll.</h1>
    <p>Home tested dishes from Lalu's Kitchen, with real nutrition info and dietary tags so you know exactly what's on your plate.</p>
  </div>
</section>

<section class="container recipe-grid-section">
  <% if (recipes.length === 0) { %>
    <div class="empty-state">
      <p>No recipes yet. Check back soon!</p>
    </div>
  <% } else { %>
    <div class="search-filter-panel">
      <div class="search-bar-container">
        <svg class="search-icon-svg" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="recipe-search" class="search-input" placeholder="Search recipes by name, description, or ingredients..." />
      </div>
      <div class="filters-group">
        <div class="filter-group-item">
          <span class="filter-label">Difficulty:</span>
          <div class="filter-tags" id="difficulty-filters">
            <button type="button" class="filter-tag is-active" data-value="all">All</button>
            <button type="button" class="filter-tag" data-value="Easy">Easy</button>
            <button type="button" class="filter-tag" data-value="Medium">Medium</button>
            <button type="button" class="filter-tag" data-value="Hard">Hard</button>
          </div>
        </div>

        <div class="filter-group-item">
          <span class="filter-label">Time:</span>
          <div class="filter-tags" id="time-filters">
            <button type="button" class="filter-tag is-active" data-value="all">All</button>
            <button type="button" class="filter-tag" data-value="quick">Quick (&lt; 30m)</button>
            <button type="button" class="filter-tag" data-value="medium">Medium (&lt; 1h)</button>
            <button type="button" class="filter-tag" data-value="slow">Slow (1h+)</button>
          </div>
        </div>

        <div class="filter-group-item">
          <span class="filter-label">Dietary:</span>
          <div class="filter-tags" id="dietary-filters">
            <% allowedTags.forEach(function(tag) { %>
              <button type="button" class="filter-tag" data-value="<%= tag %>"><%= tag %></button>
            <% }); %>
          </div>
        </div>
      </div>
    </div>

    <div class="recipe-grid" id="recipe-grid">
      <% recipes.forEach(function(recipe) { %>
        <% 
          var totalMinutes = (Number(recipe.prep_minutes) || 0) + (Number(recipe.cook_minutes) || 0);
          var ingredientNames = (recipe.ingredients || []).map(function(i) { return i.name.toLowerCase(); }).join(' ');
        %>
        <a class="recipe-card" href="/recipes/<%= recipe.slug %>"
           data-title="<%= recipe.title.toLowerCase() %>"
           data-description="<%= recipe.description.toLowerCase() %>"
           data-difficulty="<%= recipe.difficulty || '' %>"
           data-ingredients="<%= ingredientNames %>"
           data-minutes="<%= totalMinutes %>"
           data-tags="<%= (recipe.tags || []).join('|') %>">
          <div class="recipe-card__image" style="background-image: url('<%= recipe.image_path %>')"></div>
          <div class="recipe-card__body">
            <h2><%= recipe.title %></h2>
            <% if (recipe.meta.total || recipe.meta.difficulty || recipe.meta.calories) { %>
              <div class="recipe-card__meta">
                <% if (recipe.meta.total) { %><span class="meta-pill">⏱ <%= recipe.meta.total %></span><% } %>
                <% if (recipe.meta.difficulty) { %><span class="meta-pill">🍳 <%= recipe.meta.difficulty %></span><% } %>
                <% if (recipe.meta.calories) { %><span class="meta-pill">🔥 <%= recipe.meta.calories %> cal</span><% } %>
              </div>
            <% } %>
            <% if (recipe.tags && recipe.tags.length) { %>
              <div class="recipe-card__tags">
                <% recipe.tags.forEach(function(tag) { %><span class="meta-pill meta-pill--tag"><%= tag %></span><% }); %>
              </div>
            <% } %>
            <p><%= recipe.description %></p>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>
</section>

<script src="/js/recipe-helpers.js"></script>
<%- include('partials/footer') %>
