<%- include('partials/header', { pageTitle: recipe.title }) %>

<article class="recipe-page">
  <div class="container recipe-breadcrumb">
    <a href="/" class="recipe-breadcrumb__link">&larr; All recipes</a>
  </div>

  <div class="recipe-hero">
    <div class="recipe-hero__image" style="background-image: url('<%= recipe.image_path %>'); background-size: cover; background-position: center;" role="img" aria-label="<%= recipe.title %>"></div>
    <div class="recipe-hero__overlay">
      <div class="container">
        <h1><%= recipe.title %></h1>
        <p class="recipe-hero__description"><%= recipe.description %></p>
      </div>
    </div>
  </div>

  <div class="container recipe-body">
    <% if (meta.prep || meta.cook || meta.total || meta.servings || meta.difficulty) { %>
      <div class="recipe-meta-bar">
        <% if (meta.prep) { %>
          <div class="recipe-meta-bar__item">
            <span class="recipe-meta-bar__label">Prep</span>
            <span class="recipe-meta-bar__value"><%= meta.prep %></span>
          </div>
        <% } %>
        <% if (meta.cook) { %>
          <div class="recipe-meta-bar__item">
            <span class="recipe-meta-bar__label">Cook</span>
            <span class="recipe-meta-bar__value"><%= meta.cook %></span>
          </div>
        <% } %>
        <% if (meta.total) { %>
          <div class="recipe-meta-bar__item">
            <span class="recipe-meta-bar__label">Total</span>
            <span class="recipe-meta-bar__value"><%= meta.total %></span>
          </div>
        <% } %>
        <% if (meta.servings) { %>
          <div class="recipe-meta-bar__item">
            <span class="recipe-meta-bar__label">Servings</span>
            <span class="recipe-meta-bar__value"><%= meta.servings %></span>
          </div>
        <% } %>
        <% if (meta.difficulty) { %>
          <div class="recipe-meta-bar__item">
            <span class="recipe-meta-bar__label">Difficulty</span>
            <span class="recipe-meta-bar__value"><%= meta.difficulty %></span>
          </div>
        <% } %>
      </div>
    <% } %>

    <div class="unit-toggle unit-toggle--recipe" id="recipe-unit-toggle" role="group" aria-label="Unit system">
      <button type="button" class="unit-toggle__option is-active" data-unit="metric">Metric</button>
      <button type="button" class="unit-toggle__option" data-unit="imperial">Imperial</button>
    </div>

    <div class="cook-mode-trigger">
      <button type="button" class="btn btn-primary btn-large" id="start-cook-mode">👨‍🍳 Start Cooking</button>
    </div>

    <section class="recipe-section" aria-labelledby="ingredients-heading">
      <h2 id="ingredients-heading">Ingredients</h2>
      <ul class="ingredient-list">
        <% ingredientsView.forEach(function(ing, i) { %>
          <li class="ingredient">
            <label>
              <input type="checkbox" />
              <span class="ingredient-text">
                <% if (ing.convertible) { %><span class="js-amount" data-amount="<%= ing.amount %>" data-unit="<%= ing.unit %>"><%= ing.displayAmount %> <%= ing.unit %></span><% } else if (ing.amount !== null) { %><span class="ingredient-amount-static"><%= ing.displayAmount %><%= ing.unit ? ' ' + ing.unit : '' %></span><% } %>
                <%= ing.name %>
              </span>
            </label>
          </li>
        <% }); %>
      </ul>
    </section>

    <section class="recipe-section" aria-labelledby="steps-heading">
      <h2 id="steps-heading">Cooking Steps</h2>
      <ol class="step-list">
        <% stepsHtml.forEach(function(stepHtml) { %>
          <li><%- stepHtml %></li>
        <% }); %>
      </ol>
    </section>

    <% if (recipe.tips && recipe.tips.length) { %>
      <section class="recipe-section tips-section" aria-labelledby="tips-heading">
        <h2 id="tips-heading">Tips &amp; Tricks</h2>
        <ul class="tips-list">
          <% recipe.tips.forEach(function(tip) { %>
            <li><%= tip %></li>
          <% }); %>
        </ul>
      </section>
    <% } %>
  </div>

  <div class="cook-mode" id="cook-mode" role="dialog" aria-modal="true" aria-label="Cook mode: <%= recipe.title %>">
    <div class="cook-mode__header">
      <span class="cook-mode__title"><%= recipe.title %></span>
      <button type="button" class="cook-mode__close" id="cook-mode-close" aria-label="Exit cook mode">&times;</button>
    </div>
    <div class="cook-mode__progress">
      <div class="cook-mode__progress-bar" id="cook-mode-progress-bar"></div>
    </div>
    <div class="cook-mode__body">
      <span class="cook-mode__step-count" id="cook-mode-step-count"></span>
      <div class="cook-mode__step-text" id="cook-mode-step-text" aria-live="polite"></div>
    </div>
    <div class="cook-mode__nav">
      <button type="button" class="btn btn-ghost" id="cook-mode-prev">&larr; Back</button>
      <button type="button" class="btn btn-primary" id="cook-mode-next">Next &rarr;</button>
    </div>
  </div>
</article>

<script src="/js/cook-mode.js"></script>

<%- include('partials/footer') %>
